#!/bin/sh
set -eu
date -Iseconds
logger -p user.notice -t PHI-16 'PHI-16-VPS-TUNNEL-SYSLOG-20261002T194740Z source=omr-vps-01 destination=@@IPV4_007@@:514 transport=MQVPN'
ss -ntp dst @@IPV4_007@@:514
systemctl is-enabled omr-syslog-route.timer
