#!/bin/sh
set -eu
sh -n /tmp/phi12-device-monitor.sh
sh -n /tmp/phi12-device-egress.sh
stamp=$(date -u +%Y%m%dT%H%M%SZ)
dir=/tmp/phi12-device-playstation-$stamp
DEVICE_IP=@@IPV4_015@@ DEVICE_MAC=@@MAC_001@@ DURATION=3600 OUT_DIR="$dir" nohup sh /tmp/phi12-device-monitor.sh > "$dir-console.txt" 2>&1 < /dev/null &
device_pid=$!
sleep 2
kill -0 "$device_pid"
DEVICE_IP=@@IPV4_015@@ DEVICE_MAC=@@MAC_001@@ MONITOR_DIR="$dir" DURATION=3600 nohup sh /tmp/phi12-device-egress.sh > "$dir-egress-console.txt" 2>&1 < /dev/null &
egress_pid=$!
sleep 1
kill -0 "$egress_pid"
printf 'started_utc=%s\ndevice_pid=%s\negress_pid=%s\noutput_dir=%s\nduration=3600\n' "$stamp" "$device_pid" "$egress_pid" "$dir"
head -12 "$dir/egress/path-hints.csv"
