#!/bin/sh
date -Is
echo 'COMMANDS:'
for cmd in ping timeout ip nft logread ethtool tcpdump sha256sum; do command -v "$cmd"; done
echo 'PING:'
ping -V 2>&1
echo 'ROUTE CHECKS:'
ip route get @@IPV4_009@@ oif @@INTERFACE_002@@
ip route get @@IPV4_010@@ oif @@INTERFACE_003@@
ip route get @@IPV4_011@@ oif @@INTERFACE_002@@
ip route get @@IPV4_011@@ oif @@INTERFACE_003@@
ip route get @@IPV4_012@@ oif @@INTERFACE_002@@
ip route get @@IPV4_012@@ oif @@INTERFACE_003@@
ip route get @@IPV4_002@@ oif @@INTERFACE_001@@
echo 'REACHABILITY:'
ping -n -I @@INTERFACE_002@@ -c 2 -W 1 @@IPV4_009@@
ping -n -I @@INTERFACE_003@@ -c 2 -W 1 @@IPV4_010@@
echo 'TIMEOUT HELP:'
timeout --help 2>&1 | head -12
echo 'STORAGE:'
df -h /tmp
