#!/bin/sh
for addr in @@IPV4_019@@ @@IPV4_020@@ @@IPV4_021@@ @@IPV4_022@@ @@IPV4_018@@ @@IPV4_023@@ @@IPV4_024@@ @@IPV4_017@@; do
 printf '\nTARGET %s UTC %s\n' "$addr" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
 ping -n -c 2 -W 1 "$addr"
done
for spec in @@INTERFACE_002@@:@@IPV4_025@@ @@INTERFACE_003@@:@@IPV4_025@@ @@INTERFACE_001@@:@@IPV4_025@@; do
 dev=${spec%%:*}; addr=${spec#*:}
 printf '\nPATH %s UTC %s\n' "$dev" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
 ping -n -c 2 -W 1 -I "$dev" "$addr"
done
printf '\nSTORAGE\n'
df -h /tmp
du -sh /tmp/phi12-diag-20261003
