from pathlib import Path
import configparser,http.cookiejar,hashlib,json,re,urllib.error,urllib.parse,urllib.request
from html.parser import HTMLParser

ROOT=Path(__file__).resolve().parents[2]
config=configparser.ConfigParser(interpolation=None);config.read(ROOT/'Zugangsdaten/infos',encoding='utf-8')
def clean(value):
 value=(value or '').strip();return value[1:-1] if len(value)>1 and value[0]==value[-1] and value[0] in "\"'" else value
user=clean(config['old_router'].get('user'));password=clean(config['old_router'].get('passwort'))
class Inputs(HTMLParser):
 def __init__(self):super().__init__();self.items=[]
 def handle_starttag(self,tag,attrs):
  if tag.lower()=='input':self.items.append(dict(attrs))
def opener():return urllib.request.build_opener(urllib.request.HTTPCookieProcessor(http.cookiejar.CookieJar()))
def sodola(ip,label):
 result={'ip':ip,'model':label,'attempts':[]};client=opener()
 try:
  with client.open('http://'+ip+'/login.cgi',timeout=5) as r:page=r.read(400000).decode(errors='replace')
  p=Inputs();p.feed(page);fields={x.get('name'):x.get('value','') for x in p.items if x.get('name')}
  if 'Response' not in fields:raise RuntimeError('Expected legacy Sodola login form missing')
  for variant,secret in [('old_router password',password),('old_router password plus ...',password+'...')]:
   digest=hashlib.md5((user+secret).encode()).hexdigest()
   values=dict(fields);values.update(username=user,password=secret,Response=digest,language=fields.get('language','EN'))
   request=urllib.request.Request('http://'+ip+'/login.cgi',data=urllib.parse.urlencode(values).encode(),headers={'Content-Type':'application/x-www-form-urlencoded','Referer':'http://'+ip+'/login.cgi','Cookie':'admin='+digest})
   with client.open(request,timeout=6) as response:body=response.read(400000).decode(errors='replace');status=response.status;final=response.geturl()
   known_login=('name ="login"' in body or 'name="login"' in body) and 'name="Response"' in body
   err=bool(re.search(r'wrong password|login failed|incorrect|invalid (?:user|password)',body,re.I))
   success=not known_login and final.rstrip('/') not in ('http://'+ip+'/login.cgi',)
   result['attempts'].append({'variant':variant,'http_status':status,'login_form_returned':known_login,'error_banner_detected':err,'accepted':success})
   if success:
    (ROOT/'Analyse/PHI-12/switch-management-20261002'/(ip+'-authenticated-landing.html')).write_text(body,encoding='utf-8');break
 except Exception as e:result['error']=type(e).__name__
 return result
results=[sodola('@@IPV4_020@@','Sodola 218AS'),sodola('@@IPV4_021@@','Sodola 215AS')]
dest=ROOT/'Analyse/PHI-12/switch-management-20261002/credential-test-summary.json';dest.write_text(json.dumps(results,ensure_ascii=False,indent=2)+'\n',encoding='utf-8')
print(json.dumps(results,ensure_ascii=False,indent=2))
