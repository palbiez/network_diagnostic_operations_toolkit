from pathlib import Path
import configparser, http.cookiejar, json, re, urllib.error, urllib.parse, urllib.request
from html.parser import HTMLParser

ROOT=Path(__file__).resolve().parents[2]
config=configparser.ConfigParser(interpolation=None)
config.read(ROOT/'Zugangsdaten/infos',encoding='utf-8')
record=config['old_router']
def clean(value):
 value=(value or '').strip()
 if len(value)>1 and value[0]==value[-1] and value[0] in "\"'":return value[1:-1]
 return value
username=clean(record.get('user'))
password=clean(record.get('passwort'))
targets=[('@@IPV4_019@@','TP-Link SG105E'),('@@IPV4_020@@','Sodola 218AS'),('@@IPV4_021@@','Sodola 215AS')]
class FormParser(HTMLParser):
 def __init__(self):super().__init__();self.forms=[];self.active=None
 def handle_starttag(self,tag,attrs):
  attrs=dict(attrs)
  if tag.lower()=='form':
   self.active={'action':attrs.get('action','/'),'method':attrs.get('method','GET').upper(),'inputs':[]};self.forms.append(self.active)
  elif tag.lower()=='input' and self.active is not None:
   self.active['inputs'].append({k:attrs.get(k,'') for k in ['type','name','value']})
 def handle_endtag(self,tag):
  if tag.lower()=='form':self.active=None
results=[]
for ip,label in targets:
 result={'ip':ip,'model':label,'attempts':[]}
 jar=http.cookiejar.CookieJar()
 opener=urllib.request.build_opener(urllib.request.HTTPCookieProcessor(jar))
 try:
  request=urllib.request.Request('http://'+ip+'/',headers={'User-Agent':'Mozilla/5.0'})
  with opener.open(request,timeout=5) as response:landing=response.read(256000).decode(errors='replace');login_url=response.geturl()
  parser=FormParser();parser.feed(landing)
  if not parser.forms and ('/login.cgi' in landing or 'logon.cgi' in landing):
   login_url='http://'+ip+'/login.cgi'
   with opener.open(login_url,timeout=5) as response:landing=response.read(256000).decode(errors='replace');login_url=response.geturl()
   parser=FormParser();parser.feed(landing)
  form=next((f for f in parser.forms if 'password' in [x['name'] for x in f['inputs']]),None)
  if not form:raise RuntimeError('Login form not found')
  action=urllib.parse.urljoin(login_url,form['action'])
  bases=[('old_router password',password),('old_router password plus ...',password+'...')]
  for description,secret in bases:
   values={x['name']:x['value'] for x in form['inputs'] if x['name'] and x['type'].lower()=='hidden'}
   for x in form['inputs']:
    if x['name'] in ('username','password','cpassword'):values[x['name']]=username if x['name']=='username' else secret
   for x in form['inputs']:
    if x['name']=='logon':values[x['name']]=x['value'] or 'Login'
   if 'logon' not in values:values['logon']='Login'
   body=urllib.parse.urlencode(values).encode()
   post=urllib.request.Request(action,data=body,headers={'Content-Type':'application/x-www-form-urlencoded','Referer':login_url,'User-Agent':'Mozilla/5.0'})
   try:
    with opener.open(post,timeout=6) as response:
     reply=response.read(384000).decode(errors='replace');reply_url=response.geturl();status=response.status
    rejected=bool(re.search(r'id=["\']t_error1["\']|user name or the password is wrong',reply,re.I))
    parser2=FormParser();parser2.feed(reply)
    still_login=any('password' in [x['name'] for x in f['inputs']] for f in parser2.forms)
    authenticated=not rejected and not still_login and (bool(jar) or not any(s in reply.lower() for s in ['/login.cgi','logon.cgi']))
   except urllib.error.HTTPError as error:
    status=error.code;reply=error.read(16000).decode(errors='replace');reply_url=error.geturl();rejected=True;authenticated=False
   except Exception as error:
    status=None;reply='';reply_url='';rejected=False;authenticated=False;err=type(error).__name__
   outcome={'credential_variant':description,'http_status':status,'rejected':rejected,'login_page_still_present':still_login if 'still_login' in locals() else None,'session_cookie_received':bool(jar),'authenticated':authenticated}
   if 'err' in locals():outcome['error']=err;del err
   result['attempts'].append(outcome)
   if authenticated:
    (ROOT/'Analyse/PHI-12/switch-management-20261002'/(ip+'-authenticated-landing.html')).write_text(reply,encoding='utf-8')
    break
   # One attempt for each user-supplied candidate; never guess or retry.
   if description=='old_router password':form={'action':form['action'],'method':form['method'],'inputs':form['inputs']}
 except Exception as error:result['error']=type(error).__name__
 results.append(result)
out=ROOT/'Analyse/PHI-12/switch-management-20261002/credential-test-summary.json'
out.write_text(json.dumps(results,ensure_ascii=False,indent=2)+'\n',encoding='utf-8')
print(json.dumps(results,ensure_ascii=False,indent=2))
