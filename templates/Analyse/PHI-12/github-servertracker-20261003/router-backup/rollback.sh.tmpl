[ "$(hash /usr/share/omr/schedule.d/010-services)" = a23c29958c2148df89538837d6bbb89acaca10eb9ceb21e7c9853052cc66d910 ]
cp -p "$B/omr-tracker-server.before" /bin/omr-tracker-server.phi12-restore
mv /bin/omr-tracker-server.phi12-restore /bin/omr-tracker-server
cp -p "$B/010-services.before" /usr/share/omr/schedule.d/010-services.phi12-restore
mv /usr/share/omr/schedule.d/010-services.phi12-restore /usr/share/omr/schedule.d/010-services
