from pathlib import Path
import subprocess,shutil
b=Path('/root/central-telemetry-backup-20261004');p=Path('/etc/syslog-ng/syslog-ng.conf')
if not (b/'syslog-before-message-limit.conf').exists():shutil.copy2(p,b/'syslog-before-message-limit.conf')
s=p.read_text()
if 'log_msg_size(262144)' not in s:s=s.replace('options {','options { log_msg_size(262144);',1)
p.write_text(s)
r=subprocess.run(['syslog-ng','--syntax-only'],capture_output=True,text=True)
if r.returncode:shutil.copy2(b/'syslog-before-message-limit.conf',p);raise SystemExit(r.stderr)
t=Path('/etc/telegraf/telegraf.conf')
if not (b/'telegraf-before-message-limit.conf').exists():shutil.copy2(t,b/'telegraf-before-message-limit.conf')
s=t.read_text()
if 'max_message_length' not in s:s=s.replace('[[inputs.syslog]]','[[inputs.syslog]]\n  max_message_length = 262144')
t.write_text(s)
r=subprocess.run(['telegraf','--config',str(t),'--test','--input-filter','cpu'],capture_output=True,text=True)
if r.returncode:shutil.copy2(b/'telegraf-before-message-limit.conf',t);raise SystemExit('Telegraf limit config validation failed')
subprocess.run(['systemctl','reload','syslog-ng'],check=True)
subprocess.run(['systemctl','restart','telegraf'],check=True)
print('Syslog receiver and Telegraf message limit increased to 256 KiB')
