from pathlib import Path
import subprocess,re,json
p=Path('/etc/rsyslog.d/55-central-app-files.conf');s=p.read_text()
files=re.findall(r'File="([^"]+)"',s);dirs=set(str(Path(f).parent) for f in files if '*' in f)
rootfiles=[f for f in files if '*' not in f]
b=Path('/root/central-telemetry-backup-20261004/application-log-acls.txt')
if not b.exists():
 with b.open('w') as out:subprocess.run(['getfacl','-R','--absolute-names',*sorted(dirs),*rootfiles],stdout=out,check=True)
 b.chmod(0o600)
for d in sorted(dirs):
 subprocess.run(['setfacl','-R','-m','u:syslog:rX',d],check=True)
 subprocess.run(['setfacl','-m','d:u:syslog:r-x',d],check=True)
for f in rootfiles:subprocess.run(['setfacl','-m','u:syslog:r--',f],check=True)
subprocess.run(['rsyslogd','-N1'],check=True,capture_output=True)
subprocess.run(['systemctl','restart','rsyslog'],check=True)
print('Read access for syslog user configured on application logs; ACL backup',b)
for d in sorted(dirs):
 with (Path(d)/'central-forwarding-audit.log').open('a') as f:f.write('CENTRAL-APPFILE-20261004-ACL-VERIFIED dir='+d+'\n')
