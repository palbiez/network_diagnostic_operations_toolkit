ROOT=Path(__file__).resolve().parents[2]
spec=importlib.util.spec_from_file_location('switch',ROOT/'Analyse/PHI-12/read-switch-authenticated.py');m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)
m.OUT=ROOT/'Analyse/Zentrale-Telemetrie-20261004/switches';m.OUT.mkdir(exist_ok=True)
