import sys,json,time,concurrent.futures,collections
from pathlib import Path
ROOT=Path(__file__).resolve().parents[2]
sys.path.insert(0,str(ROOT/'Skripte/Diagnose'))
from central_observability import run,OUT
marker='CENTRAL-FINAL-20261004-'+str(int(time.time()))
ips=['@@IPV4_008@@','@@IPV4_022@@','@@IPV4_086@@','@@IPV4_033@@','@@IPV4_007@@','@@IPV4_087@@','@@IPV4_088@@','@@IPV4_084@@','@@IPV4_085@@','@@IPV4_012@@:65222','@@IPV4_089@@']
cmd='logger -t CENTRAL-FINAL '+marker+'\ndate -u +%s\nuptime\nif command -v uci >/dev/null; then /etc/init.d/collectd status; /etc/init.d/collectd enabled; /etc/init.d/luci_statistics enabled; else systemctl is-active syslog-ng rsyslog node_exporter prometheus-node-exporter 2>/dev/null; fi'
