found=[];app=[]
for p in Path('/var/log/network').glob('*/2026-10-04-syslog.log'):
    seen=False;appdirs=set()
    with p.open(errors='replace') as f:
        for l in f:
            if marker in l:seen=True
            if 'CENTRAL-APPFILE-20261004-ACL-VERIFIED' in l:
                appdirs.add(l.split('dir=',1)[-1].strip())
    if seen:found.append(p.parent.name)
    if appdirs:app.append((p.parent.name,sorted(appdirs)))
print('FRESH_SYSLOG_MARKER_HOSTS',sorted(found),'COUNT',len(found))
print('APPLICATION_FILE_MARKERS',app)
op=urllib.request.build_opener(urllib.request.ProxyHandler({}))
for q in ['up','network_switch_up','node_textfile_scrape_error']:
    d=json.load(op.open('http://127.0.0.1:9090/api/v1/query?query='+urllib.parse.quote(q),timeout=10))
    print('PROM',q,[(r['metric'],r['value'][1]) for r in d['data']['result']])
for host in ['OpenMPTCProuter','WR1300v3','wr1300ap']:
    p=Path('/var/log/network/mqtt')/host/'2026-10-04.jsonl';last=None;count=0
