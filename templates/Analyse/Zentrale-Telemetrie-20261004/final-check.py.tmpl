        for l in f:
            r=json.loads(l)
            if r['qos']==1 and not r['retained']:last=r;count+=1
    print('MQTT_ARCHIVE',host,'fresh_qos1_records',count,'latest',last['received_at'],'payload_timestamp',last['payload'].split(':')[0])
PY
systemctl is-active syslog-ng prometheus node_exporter mqtt-archive omr-node-exporter-tunnel telegraf mosquitto loki alloy
systemctl is-enabled syslog-ng prometheus node_exporter mqtt-archive omr-node-exporter-tunnel telegraf mosquitto switch-monitor.timer network-archive-compress.timer
syslog-ng --syntax-only 2>&1 | tail -2
promtool check config /etc/prometheus/prometheus.yml
