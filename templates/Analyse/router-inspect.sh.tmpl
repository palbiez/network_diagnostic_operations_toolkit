#!/bin/sh
printf '\nDEBUGLOGGER\n'
ubus call service list '{"name":"mqvpn-debuglog"}'
/bin/busybox ps | grep -e logread -e mqvpn-debug
/etc/init.d/mqvpn-debuglog disable
/etc/init.d/mqvpn-debuglog stop
printf '\nAFTER\n'
ubus call service list '{"name":"mqvpn-debuglog"}'
/bin/busybox ps | grep -e logread -e mqvpn-debug
ls /etc/rc.d/*mqvpn-debuglog 2>/dev/null
printf '\nNIC\n'
for nic in @@INTERFACE_002@@ @@INTERFACE_005@@ @@INTERFACE_003@@; do
 echo "$nic"; ethtool -i "$nic"; ethtool --show-eee "$nic"; ethtool "$nic" | grep -e Speed -e Duplex -e Link; ethtool -S "$nic" | grep -e error -e drop -e timeout -e crc; done
printf '\nTUNNEL\n'
ip -4 addr show @@INTERFACE_001@@; mqvpn-path list; ip rule; ip route show table all | head -100
printf '\nLOGSERVICE\n'
ubus list log; /sbin/logread -h 2>&1 | head -20
printf '\nMQVPN\n'
uci show mqvpn | grep -v -e auth.key -e auth.user
printf '\nVALIDATION\n'
fw4 check 2>&1 | head -60
printf '\nMEMORY\n'
free; sysctl net.core.rmem_max net.core.rmem_default net.netfilter.nf_conntrack_count net.netfilter.nf_conntrack_max
