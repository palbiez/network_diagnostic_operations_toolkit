sudo -n python3 - <<'PY'
import subprocess
code=r'''
const fs=require('fs');
const sockets=fs.readFileSync('/proc/net/tcp','utf8').split('\n').filter(l=>l.includes(':075B')).map(l=>l.trim().split(/\s+/));
const names=new Map(sockets.map(l=>[l[9],l.slice(1,4)]));
for(const pid of fs.readdirSync('/proc').filter(x=>/^\d+$/.test(x))){
try{for(const fd of fs.readdirSync('/proc/'+pid+'/fd')){try{const link=fs.readlinkSync('/proc/'+pid+'/fd/'+fd);const id=link.match(/^socket:\[(\d+)\]$/);if(id&&names.has(id[1]))console.log(pid,fs.readFileSync('/proc/'+pid+'/comm','utf8').trim(),names.get(id[1]));}catch(e){}}}catch(e){}
}
'''
for name in ['app_a0d7b954_nodered','app_df2164f9_ps5_mqtt']:
    print(name,flush=True)
    subprocess.run(['docker','exec','-i',name,'node','-'],input=code.encode())
