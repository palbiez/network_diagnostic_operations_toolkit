sudo -n docker exec -i homeassistant python3 - <<'PY'
from pathlib import Path
sockets={l.split()[9]:l.split()[1:4] for l in Path('/proc/net/tcp').read_text().splitlines() if ':075B' in l}
for p in Path('/proc').iterdir():
    if not p.name.isdigit():continue
    try:
        for fd in (p/'fd').iterdir():
            try:
                link=str(fd.readlink()); inode=link.removeprefix('socket:[').removesuffix(']')
                if inode in sockets:print('core',p.name,(p/'comm').read_text().strip(),sockets[inode])
            except OSError:pass
    except OSError:pass
PY
