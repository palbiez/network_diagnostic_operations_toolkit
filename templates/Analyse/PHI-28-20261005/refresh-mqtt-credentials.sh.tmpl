(async()=>{
const fs=require('fs');
const ha=JSON.parse(fs.readFileSync('/homeassistant/.storage/core.config_entries')).data.entries.find(x=>x.domain==='mqtt').data;
const base='http://127.0.0.1:46836';
const r=await fetch(base+'/flows',{headers:{'Node-RED-API-Version':'v2'}}); if(!r.ok)throw new Error('read '+r.status);
const current=await r.json();
console.log('active MQTT brokers',current.flows.filter(n=>n.type==='mqtt-broker').map(n=>({id:n.id,name:n.name,broker:n.broker})));
const n=current.flows.find(n=>n.id==='489094618c340eef');
if(!n||n.broker!=='@@IPV4_007@@')throw new Error('Unexpected active broker');
n.credentials={user:ha.username,password:ha.password};
const result=await fetch(base+'/flows',{method:'POST',headers:{'Content-Type':'application/json','Node-RED-API-Version':'v2','Node-RED-Deployment-Type':'nodes'},body:JSON.stringify(current)});
console.log('credential refresh',result.status,await result.text());
if(!result.ok)process.exitCode=1;
})();
