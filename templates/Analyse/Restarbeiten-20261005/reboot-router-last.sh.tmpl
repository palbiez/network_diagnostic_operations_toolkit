nft list chain inet fw4 mangle_prerouting | grep -E '@@INTERFACE_008@@.*(srcip|mac)_4_gaming' | head -4
conntrack -L -s @@IPV4_015@@ 2>/dev/null | head -2
conntrack -L -s @@IPV4_016@@ 2>/dev/null | head -2
grep -F '@@NETWORK_PREFIX_004@@' /tmp/dhcp.leases || true
