date -Iseconds
mqvpn-path list
uci -q get mqvpn.multipath.auto_wan || echo auto_wan_default_1
uci get firewall.omr_dscp_rule2.src_port
uci get firewall.omr_dscp_rule4.dest_port
fw4 check >/tmp/phi-last-check.log 2>&1; echo fw4_exit=$?
