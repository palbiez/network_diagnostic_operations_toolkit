from pathlib import Path
import urllib.request,re
out=Path(__file__).resolve().parent
sources={'netifd-system-linux.c':'https://raw.githubusercontent.com/openwrt/netifd/6088f7b3/system-linux.c','netifd-device.c':'https://raw.githubusercontent.com/openwrt/netifd/6088f7b3/device.c','netifd-interface-ip.c':'https://raw.githubusercontent.com/openwrt/netifd/6088f7b3/interface-ip.c','nlbwmon-nfnetlink.c':'https://raw.githubusercontent.com/jow-/nlbwmon/29236be6/nfnetlink.c','nlbwmon-client.c':'https://raw.githubusercontent.com/jow-/nlbwmon/29236be6/client.c'}
for name,url in sources.items():
    text=urllib.request.urlopen(url).read().decode();(out/name).write_text(text,encoding='utf-8');lines=text.splitlines()
    print(name)
    pattern=r'Netlink receive failure|Unable to dump|NLE_NOMEM|ENOBUFS|nl_socket_set_buffer_size|90000|iif.*lo|orig_settings|system_if_set_mtu|DEV_OPT_MTU'
    matches=[i for i,l in enumerate(lines) if re.search(pattern,l)]
    for i in matches:
        print('\n'.join(f'{j+1}: {lines[j]}' for j in range(max(0,i-3),min(len(lines),i+5))))
