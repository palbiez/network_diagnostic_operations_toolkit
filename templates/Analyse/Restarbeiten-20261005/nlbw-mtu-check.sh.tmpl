apk list --installed 2>/dev/null | grep -E '^netifd-|^nlbwmon-|^libnl-tiny-|^mqvpn-'
cat /proc/sys/net/core/rmem_max
cat /proc/sys/net/core/rmem_default
logread | grep -E 'nlbwmon|MTU changed externally' | tail -n 18
nlbw -c json > /tmp/phi22-stats.json
wc -c /tmp/phi22-stats.json
head -c 350 /tmp/phi22-stats.json
echo
grep -E 'VmRSS|Threads' /proc/$(pidof nlbwmon)/status
ubus call network.device status '{"name":"@@INTERFACE_001@@"}'
grep -n -E 'mtu|metric|ip4table' /etc/config/network
ubus call network.interface.omrvpn status
ping -c 3 -W 1 -I @@INTERFACE_001@@ @@IPV4_002@@
