set -eu
for n in phi21-fw phi21-cli phi21-net; do ! ip netns list | grep -q "^$n "; done
cleanup() {
    if [ -s /tmp/phi21-isolated.pid ]; then kill "$(cat /tmp/phi21-isolated.pid)" 2>/dev/null || true; fi
    for n in phi21-fw phi21-cli phi21-net; do
        ip netns pids "$n" 2>/dev/null | xargs -r kill 2>/dev/null || true
        ip netns del "$n" 2>/dev/null || true
    done
}
