from pathlib import Path
import difflib
folder=Path(__file__).resolve().parent
p=folder/'mqvpn-src-platform-linux-netlink_mon.c';original=p.read_text(encoding='utf-8')
needle='    if (mtu <= 0 || want <= 0 || mtu == want) return;\n'
assert original.count(needle)==1
addition='''
    /* RTM_NEWLINK may have been queued before TUN negotiation completed.
     * Verify the live kernel MTU before treating an old snapshot as a setter. */
    int probe_fd = socket(AF_INET, SOCK_DGRAM | SOCK_CLOEXEC, 0);
    if (probe_fd >= 0) {
        struct ifreq ifr;
        memset(&ifr, 0, sizeof(ifr));
        strncpy(ifr.ifr_name, p->tun.name, IFNAMSIZ - 1);
        if (ioctl(probe_fd, SIOCGIFMTU, &ifr) == 0) mtu = ifr.ifr_mtu;
        close(probe_fd);
        if (mtu == want) return;
    }
'''
fixed=original.replace(needle,needle+addition,1)
patch=''.join(difflib.unified_diff(original.splitlines(True),fixed.splitlines(True),fromfile='a/src/platform/linux/netlink_mon.c',tofile='b/src/platform/linux/netlink_mon.c'))
(folder/'PHI14-live-mtu-check.proposed.patch').write_text(patch,encoding='utf-8')
print('Proposed source patch written; not compiled or installed')
