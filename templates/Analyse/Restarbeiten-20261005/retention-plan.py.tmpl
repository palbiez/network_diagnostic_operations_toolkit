"""Read-only daily syslog retention preview. Never changes or removes files."""
from pathlib import Path
from datetime import date
import argparse,json,re,os,stat

def action(name,today,plain_days,total_days,opened=False):
    match=re.fullmatch(r'(\d{4}-\d{2}-\d{2})(?:-syslog\.log|\.jsonl)(\.gz)?',name)
    if not match or opened:return 'protect'
    try:age=(today-date.fromisoformat(match[1])).days
    except ValueError:return 'protect'
    if age < 0:return 'protect'
    if age>total_days:return 'delete_proposal'
    if age>plain_days and not match[2]:return 'compress_proposal'
    return 'keep'

def opened_inodes():
    result=set()
    for proc in Path('/proc').glob('[0-9]*/fd'):
        try:fds=list(proc.iterdir())
        except OSError:continue
        for fd in fds:
            try:s=fd.stat();result.add((s.st_dev,s.st_ino))
            except OSError:pass
    return result

if __name__=='__main__':
    p=argparse.ArgumentParser();p.add_argument('--root',default='/var/log/network')
    p.add_argument('--today',default=date.today().isoformat());p.add_argument('--plain-days',type=int,default=2)
    p.add_argument('--total-days',type=int,default=90);p.add_argument('--self-test',action='store_true');a=p.parse_args()
    if a.self_test:
        t=date(2026,10,5)
        cases={'2026-10-05-syslog.log':'keep','2026-10-03-syslog.log':'keep','2026-10-02-syslog.log':'compress_proposal','2026-07-06-syslog.log.gz':'delete_proposal','messages':'protect','2026-02-30-syslog.log':'protect','2026-10-06-syslog.log':'protect'}
        for n,want in cases.items():assert action(n,t,2,90)==want,(n,want)
        assert action('2026-07-06-syslog.log',t,2,90,True)=='protect'
        assert action('2026-10-02.jsonl',t,2,90)=='compress_proposal'
        assert action('2026-07-06.jsonl.gz',t,2,90)=='delete_proposal'
        print('10 policy checks passed; no mutations');raise SystemExit
    if not 0<=a.plain_days<a.total_days:raise SystemExit('Require 0 <= plain-days < total-days')
    root=Path(a.root).resolve(strict=True);opened=opened_inodes();rows=[]
    # walk never follows directory symlinks; lstat rejects file symlinks.
    for parent,dirs,files in os.walk(root,followlinks=False):
        dirs[:]=[d for d in dirs if not (Path(parent)/d).is_symlink()]
        for name in files:
            f=Path(parent)/name;s=f.lstat()
            if not stat.S_ISREG(s.st_mode):continue
            act=action(name,date.fromisoformat(a.today),a.plain_days,a.total_days,(s.st_dev,s.st_ino) in opened)
            rows.append({'path':str(f.relative_to(root)),'bytes':s.st_size,'action':act})
    print(json.dumps({'mode':'PREVIEW_ONLY','root':str(root),'plainDays':a.plain_days,'totalDays':a.total_days,'files':rows},indent=2))
