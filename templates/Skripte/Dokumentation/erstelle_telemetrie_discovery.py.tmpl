def read(name):
    return json.loads((EVIDENCE / name).read_text(encoding='utf-8'))


def link(source, parent):
    return Path(os.path.relpath(ROOT / source, parent)).as_posix()


def pair(stem, data, markdown, sources):
    data = dict(schema_version='1.0', stand=STAND, zeitzone='Europe/Berlin',
                grundlage='Abschlussnachweise; keine erneute Liveabfrage bei Dokumenterzeugung',
                **data)
    data['quellen'] = [dict(pfad=s, sha256=hashlib.sha256((ROOT / s).read_bytes()).hexdigest())
                       for s in dict.fromkeys(sources)]
    data['markdown'] = markdown
    stem.parent.mkdir(parents=True, exist_ok=True)
    stem.with_suffix('.md').write_text(markdown, encoding='utf-8')
    stem.with_suffix('.json').write_text(json.dumps(data, ensure_ascii=False, indent=2)+'\n', encoding='utf-8')


