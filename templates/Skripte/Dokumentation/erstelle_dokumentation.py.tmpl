def render(d):
    parts = [f"# {d['titel']}", f"Stand: {STAND} · Zeitzone: Europe/Berlin · Grundlage: lokale Projektunterlagen", d['zusammenfassung']]
    for section in d['abschnitte']:
        parts.extend([f"## {section['ueberschrift']}", section['markdown']])
    parts += ['## Lokale Quellen und Nachweise', '\n'.join(f"- [{p}](../{p})" for p in d['quellen'])]
    if d['issues']:
        parts += ['Zugeordnete Arbeitspakete: ' + ', '.join(f'[{i}](../Linear/issues/{i}.md)' for i in d['issues']) + '.']
    parts += [@@PYTHON_STRING_099@@]
    return '\n\n'.join(parts) + '\n'


