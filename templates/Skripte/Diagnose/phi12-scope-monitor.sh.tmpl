#!/bin/sh
# Connection metadata for an IPv4 subnet, optionally narrowed to one chat client.
set -eu
umask 077
SCOPE=${SCOPE:?}
OUT_DIR=${OUT_DIR:?}
END_EPOCH=${END_EPOCH:?}
MODE=${MODE:-gaming}
LAN_DEV=${LAN_DEV:?}
case "$SCOPE" in *[!0-9./]*) exit 2;; esac
case "$OUT_DIR" in /tmp/phi12-evening-*) ;; *) exit 2;; esac
case "${OUT_DIR#/tmp/}" in */*) exit 2;; esac
case "$END_EPOCH" in ''|*[!0-9]*) exit 2;; esac
case "$MODE" in gaming|application) ;; *) exit 2;; esac
mkdir "$OUT_DIR"
printf 'scope=%s\nmode=%s\nend_epoch=%s\n' "$SCOPE" "$MODE" "$END_EPOCH" > "$OUT_DIR/settings.txt"
printf 'utc,device,target,proto,source_port,destination_port,reply_destination,nat_port,path_hint\n' > "$OUT_DIR/paths.csv"
printf 'utc,event\n' > "$OUT_DIR/events.csv"
wan1=$(ip -o -4 addr show @@INTERFACE_002@@ | awk '{split($4,a,"/");print a[1];exit}')
wan2=$(ip -o -4 addr show @@INTERFACE_003@@ | awk '{split($4,a,"/");print a[1];exit}')
known="$OUT_DIR/application-targets.txt"
: > "$known"
child=''
event_pid=''
event_part=0
start_events() {
 event_part=$((event_part+1))
 conntrack -E -s "$SCOPE" -e NEW,DESTROY -o timestamp,extended > "$OUT_DIR/flow-events-$event_part.log" 2> "$OUT_DIR/flow-events-$event_part-status.txt" &
 event_pid=$!
}
cleanup() {
 trap - EXIT INT TERM HUP
 [ -z "$child" ] || kill -TERM "$child" 2>/dev/null || true
 [ -z "$child" ] || wait "$child" 2>/dev/null || true
 [ -z "$event_pid" ] || kill -TERM "$event_pid" 2>/dev/null || true
 [ -z "$event_pid" ] || wait "$event_pid" 2>/dev/null || true
 printf '%s,stopped\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$OUT_DIR/events.csv"
}
trap cleanup EXIT
trap 'exit 0' INT TERM HUP
printf '%s,started\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$OUT_DIR/events.csv"
[ "$MODE" != gaming ] || start_events
next_dns=0
next_state=0
while [ "$(date +%s)" -lt "$END_EPOCH" ]; do
 [ ! -e "$OUT_DIR/stop" ] || break
 [ "$(du -sk "$OUT_DIR" | awk '{print $1}')" -lt 262144 ] || { echo 'Size limit reached'; break; }
 if [ -n "$event_pid" ] && [ "$(du -k "$OUT_DIR/flow-events-$event_part.log" | awk '{print $1}')" -ge 32768 ]; then
  kill -TERM "$event_pid" 2>/dev/null || true
  wait "$event_pid" 2>/dev/null || true
  start_events
 fi
 now=$(date +%s)
 stamp=$(date -u +%Y%m%dT%H%M%SZ)
 if [ "$MODE" = application ] && [ "$now" -ge "$next_dns" ]; then
  for host in @@HOSTNAME_008@@ @@HOSTNAME_009@@ @@HOSTNAME_025@@ @@HOSTNAME_026@@; do
   file="$OUT_DIR/dns-$host-$stamp.txt"
   timeout 4 nslookup "$host" > "$file" 2>&1 || true
   awk '/^Name:/{answer=1} answer && /^Address([[:space:]]+[0-9]+)?:/{for(i=2;i<=NF;i++) if($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) print $i}' "$file" >> "$known"
  done
  sort -u "$known" > "$known.next"; mv "$known.next" "$known"
  next_dns=$((now+60))
 fi
 conntrack -L -s "$SCOPE" -o extended > "$OUT_DIR/current-all.txt" 2>> "$OUT_DIR/conntrack-status.txt" || true
 # Keep all gaming flows; chat scope includes mapped domains and new bypass ports.
 awk -v mode="$MODE" -v targets="$known" '
 BEGIN{while((getline ip < targets)>0) known[ip]=1;close(targets)}
 {target="";port=0;for(i=1;i<=NF;i++){split($i,a,"=");if(a[1]=="dst" && target=="")target=a[2];if(a[1]=="dport" && port==0)port=a[2]+0}
 if(mode=="gaming" || known[target] || port==843 || (port>=8000 && port<=8010))print}' "$OUT_DIR/current-all.txt" > "$OUT_DIR/current.txt"
 awk -v utc="$stamp" -v w1="$wan1" -v w2="$wan2" '
 {proto=$3;ns=0;nd=0;nsp=0;ndp=0;device="";target="";nat="";sport="";port="";natport="";replysrc="";
 for(i=1;i<=NF;i++){split($i,a,"=");if(a[1]=="src"){ns++;if(ns==1)device=a[2];else replysrc=a[2]};if(a[1]=="dst"){nd++;if(nd==1)target=a[2];else nat=a[2]};if(a[1]=="sport"){nsp++;if(nsp==1)sport=a[2]};if(a[1]=="dport"){ndp++;if(ndp==1)port=a[2];else natport=a[2]}}
 hint="LOCAL_OR_OTHER";if(nat==w1)hint="WAN1";else if(nat==w2)hint="WAN2";else if(nat ~ /^10\.255\.220\./)hint="TUNNEL";else if(replysrc!=target)hint="LOCAL_PROXY_OR_REDIRECT";
 if(target!="")print utc "," device "," target "," proto "," sport "," port "," nat "," natport "," hint;
 }' "$OUT_DIR/current.txt" >> "$OUT_DIR/paths.csv"
 if [ "$now" -ge "$next_state" ]; then
  ip neigh show dev "$LAN_DEV" > "$OUT_DIR/neighbours-$stamp.txt"
  cp /tmp/dhcp.leases "$OUT_DIR/leases-$stamp.txt"
  nft -a list ruleset > "$OUT_DIR/nft-$stamp.txt"
  ip route show table all > "$OUT_DIR/routes-$stamp.txt"
  # Only sampled packets, bounded in count/time; exact translated tuples only.
  awk -v w1="$wan1" -v w2="$wan2" '
  BEGIN{sep="";count=0}
  {ns=0;nd=0;ndp=0;target="";nat="";port="";natport="";replysrc="";proto=$3;
   for(i=1;i<=NF;i++){split($i,a,"=");if(a[1]=="src"){ns++;if(ns==2)replysrc=a[2]};if(a[1]=="dst"){nd++;if(nd==1)target=a[2];else nat=a[2]};if(a[1]=="dport"){ndp++;if(ndp==1)port=a[2];else natport=a[2]}}
   if(count<128 && (proto=="tcp" || proto=="udp") && replysrc==target && (nat==w1 || nat==w2 || nat ~ /^10\.255\.220\./)){
    printf "%s(%s and ((src host %s and dst host %s and src port %s and dst port %s) or (src host %s and dst host %s and src port %s and dst port %s)))",sep,proto,nat,target,natport,port,target,nat,port,natport;sep=" or ";count++}
  }END{print ""}' "$OUT_DIR/current.txt" > "$OUT_DIR/wire-filter-$stamp.txt"
  filter=$(cat "$OUT_DIR/wire-filter-$stamp.txt")
  if [ -n "$filter" ]; then
   tcpdump -i any -n -tt -l -q -s 80 -c 2000 "$filter" > "$OUT_DIR/wire-$stamp.log" 2> "$OUT_DIR/wire-$stamp-status.txt" &
   child=$!
   sleep 5
   kill -TERM "$child" 2>/dev/null || true
   wait "$child" 2>/dev/null || true
   child=''
  fi
  next_state=$((now+60))
 fi
 if [ -e "$OUT_DIR/trigger" ]; then printf '%s,user_event\n' "$stamp" >> "$OUT_DIR/events.csv";rm -f "$OUT_DIR/trigger";fi
 sleep 5
done
