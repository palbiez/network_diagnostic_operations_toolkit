#!/bin/sh
# IPv4 connection metadata for DNS-mapped application targets; no packet/content archive.
set -eu
umask 077
DEVICE_IP=${DEVICE_IP:-@@IPV4_026@@}
DEVICE_MAC=${DEVICE_MAC:-@@MAC_005@@}
DURATION=${DURATION:-3600}
MAX_KB=${MAX_KB:-32768}
case "$DEVICE_IP" in ''|*[!0-9.]*|.*) exit 2;; esac
case "$DEVICE_MAC" in ''|*[!0-9a-fA-F:]*) exit 2;; esac
for value in "$DURATION" "$MAX_KB"; do case "$value" in ''|*[!0-9]*) exit 2;; esac; done
[ "$DURATION" -ge 5 ] && [ "$DURATION" -le 86400 ] && [ "$MAX_KB" -ge 1024 ] || exit 2
OUT_DIR=${OUT_DIR:-/tmp/phi12-application-$(date -u +%Y%m%dT%H%M%SZ)-$$}
case "$OUT_DIR" in /tmp/phi12-application-*) ;; *) exit 2;; esac
case "${OUT_DIR#/tmp/}" in */*) exit 2;; esac
[ ! -e "$OUT_DIR" ] || exit 2
mkdir -p "$OUT_DIR"
dev=$(ip route get "$DEVICE_IP" | awk '{for(i=1;i<=NF;i++) if($i=="dev") {print $(i+1);exit}}')
[ -n "$dev" ] || { echo 'Cannot find LAN interface'; exit 1; }
neighbour=$(ip neigh show "$DEVICE_IP" dev "$dev")
echo "$neighbour" > "$OUT_DIR/device-neighbour-start.txt"
echo "$neighbour" | grep -iq "lladdr $DEVICE_MAC" || { echo 'IP/MAC not verified; aborting'; exit 1; }
command -v conntrack >/dev/null
command -v tcpdump >/dev/null
pids=''
reason=duration
utc() { date -u +%Y-%m-%dT%H:%M:%SZ; }
event() { printf '%s,%s\n' "$(utc)" "$1" >> "$OUT_DIR/events.csv"; }
cleanup() {
 trap - EXIT INT TERM HUP
 for pid in $pids; do kill -TERM "$pid" 2>/dev/null || true; done
 for pid in $pids; do wait "$pid" 2>/dev/null || true; done
 event "stopped:$reason"
 echo "STOPPED: $OUT_DIR ($reason)"
}
trap cleanup EXIT
trap 'reason=signal; exit 0' INT TERM HUP
printf 'utc,event\n' > "$OUT_DIR/events.csv"
printf 'device_ip=%s\ndevice_mac=%s\ninterface=%s\nduration=%s\n' "$DEVICE_IP" "$DEVICE_MAC" "$dev" "$DURATION" > "$OUT_DIR/settings.txt"
: > "$OUT_DIR/known-targets.txt"
echo "STARTED: $OUT_DIR"
echo "Stop: touch $OUT_DIR/stop ; mark interruption: touch $OUT_DIR/trigger"
event started_metadata_only
start=$(date +%s)
last_dns=0
while [ "$(date +%s)" -lt "$((start+DURATION))" ]; do
 [ ! -e "$OUT_DIR/stop" ] || { reason=stop_file; break; }
 used=$(du -sk "$OUT_DIR" | awk '{print $1}')
 [ "$used" -lt "$MAX_KB" ] || { reason=size_limit; break; }
 if [ -e "$OUT_DIR/trigger" ]; then event user_interruption; rm -f "$OUT_DIR/trigger"; fi
 neighbour=$(ip neigh show "$DEVICE_IP" dev "$dev")
 actual_mac=$(echo "$neighbour" | awk '{for(i=1;i<=NF;i++) if($i=="lladdr") {print $(i+1);exit}}')
 if [ -n "$actual_mac" ] && [ "$(echo "$actual_mac" | tr A-F a-f)" != "$(echo "$DEVICE_MAC" | tr A-F a-f)" ]; then
  reason=mac_mismatch; event wrong_device_detected; break
 fi
 now=$(date +%s)
 if [ "$((now-last_dns))" -ge 60 ]; then
  last_dns=$now
  for host in @@HOSTNAME_008@@ @@HOSTNAME_009@@ @@HOSTNAME_025@@ @@HOSTNAME_026@@; do
   lookup="$OUT_DIR/dns-$host-$now.txt"
   timeout 4 nslookup "$host" > "$lookup" 2>&1 || event "dns_lookup_error:$host"
   # Skip resolver address; only accept IPv4 answer records after Name:.
   awk '/^Name:/{answer=1} answer && /^Address([[:space:]]+[0-9]+)?:/{for(i=2;i<=NF;i++) if($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) print $i}' "$lookup" |
    sort -u > "$OUT_DIR/new-targets.txt"
   while IFS= read -r target; do
    [ -n "$target" ] || continue
    grep -Fxq "$target" "$OUT_DIR/known-targets.txt" && continue
    [ "$(wc -l < "$OUT_DIR/known-targets.txt")" -lt 24 ] || { event target_limit; continue; }
    echo "$target" >> "$OUT_DIR/known-targets.txt"
    event "dns_mapped_candidate:$host:$target"
    conntrack -E -s "$DEVICE_IP" -d "$target" -o timestamp,extended > "$OUT_DIR/conntrack-events-$target.log" 2>&1 &
    pids="$pids $!"
    # Quiet text output: endpoint/protocol/length metadata, no -A/-X/-w payload output.
    tcpdump -n -tt -l -q -s 80 -i "$dev" "ether host $DEVICE_MAC and host $DEVICE_IP and host $target and (tcp or udp)" > "$OUT_DIR/packets-$target.log" 2> "$OUT_DIR/tcpdump-$target-status.txt" &
    pids="$pids $!"
   done < "$OUT_DIR/new-targets.txt"
  done
 fi
 while IFS= read -r target; do
  printf '\nUTC %s target %s\n' "$(utc)" "$target" >> "$OUT_DIR/connection-snapshots.log"
  conntrack -L -s "$DEVICE_IP" -d "$target" -o extended >> "$OUT_DIR/connection-snapshots.log" 2>> "$OUT_DIR/conntrack-status.txt" || true
 done < "$OUT_DIR/known-targets.txt"
 sleep 2
done
