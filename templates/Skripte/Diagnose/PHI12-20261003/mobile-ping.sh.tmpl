#!/bin/sh
umask 077
target=$1; end=$2; file=$3
while [ "$(date +%s)" -lt "$end" ]; do
 printf 'probe_utc=%s target=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$target" >> "$file"
 ping -n -D -c 1 -W 1 "$target" >> "$file" 2>&1
 rc=$?
 delay=1; [ "$rc" -eq 0 ] || delay=300
 printf 'result_utc=%s rc=%s next_delay_s=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$rc" "$delay" >> "$file"
 remaining=$((end-$(date +%s)))
 [ "$remaining" -gt 0 ] || break
 [ "$delay" -le "$remaining" ] || delay=$remaining
 sleep "$delay"
done
