guard='WAN-Adressen @@IPV4_004@@ und @@IPV4_005@@ erhalten. MSS 1384 / @@INTERFACE_001@@ MTU 1382 / VPS MTU 1350 nicht pauschal ändern. Keinen network restart zu Diagnosezwecken. UCI/LuCI bevorzugen. Vor Änderungen sichern, jeweils eine Änderung testen; MQVPN-Neustart kann LAN-Routing beeinträchtigen.'
items=[]
def add(key,title,priority,finding,steps,acceptance,sources,depends=(),done=False):
    description=f'''## Problem und Befund

{finding}

## Vorgehen

{steps}

## Abschlusskriterien

{acceptance}

## Rahmen und Rückweg

{guard}

## Nachweise

Stand 02.10.2026. Lokale Dateien im Arbeitsordner Netzwerkumgebung:
'''+''.join(f'- `{s}`\n' for s in sources)+f'\nSynchronisationskennung: `omr-workpackage:{key}`\n'
    items.append({'key':key,'title':title,'priority':priority,'state':'Done' if done else ('Todo' if priority==2 else 'Backlog'),'description':description,'sources':list(sources),'dependsOn':list(depends)})

