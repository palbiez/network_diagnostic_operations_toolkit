"""Linear GraphQL client; API key stays in a user-bound Windows DPAPI file."""
from pathlib import Path
import json
import os
import subprocess
import urllib.request
import urllib.error

ROOT = Path(__file__).resolve().parents[2]

def api_key():
    path = ROOT / 'Zugangsdaten' / 'linear-api-key.dpapi'
    env = dict(os.environ, LINEAR_DPAPI_PATH=str(path))
    script = "$ErrorActionPreference = 'Stop'; $s = (Get-Content -LiteralPath $env:LINEAR_DPAPI_PATH -Raw).Trim() | ConvertTo-SecureString; $c = New-Object System.Management.Automation.PSCredential('linear', $s); [Console]::Write($c.GetNetworkCredential().Password)"
    result = subprocess.run(['powershell.exe', '-NoProfile', '-NonInteractive', '-Command', script], env=env, capture_output=True, text=True, check=True)
    key = result.stdout.strip()
    if not key.startswith('lin_api_'):
        raise RuntimeError('Could not load Linear key from DPAPI file.')
    return key

class Linear:
    def __init__(self):
        self.key = api_key()

    def query(self, query, variables=None):
        request = urllib.request.Request('https://api.linear.app/graphql',
            data=json.dumps({'query':query, 'variables':variables or {}}).encode('utf-8'),
            headers={'Authorization':self.key, 'Content-Type':'application/json', 'User-Agent':'OpenMPTCP-local-sync/1.0'})
        try:
            with urllib.request.urlopen(request, timeout=45) as response:
                result = json.load(response)
        except urllib.error.HTTPError as error:
            try:
                detail = json.loads(error.read())
                message = '; '.join(e.get('message','Unknown error') for e in detail.get('errors',[]))
            except (ValueError, UnicodeError):
                message = 'operation not confirmed'
            raise RuntimeError(f'Linear API HTTP {error.code}: {message}') from None
        if result.get('errors'):
            debug = ROOT / 'Linear' / 'last-api-errors.json'
            debug.parent.mkdir(exist_ok=True)
            debug.write_text(json.dumps(result['errors'], ensure_ascii=False, indent=2), encoding='utf-8')
            raise RuntimeError('Linear GraphQL: ' + '; '.join(e.get('message','Unknown error') for e in result['errors']))
        return result['data']

if __name__ == '__main__':
    client = Linear()
    data = client.query('''{ viewer { id name organization { id name urlKey } }
      projects(first:20) { nodes { id name slugId url teams(first:5) { nodes { id name key } } } pageInfo { hasNextPage endCursor } }
    }''')
    target = ROOT / 'Linear'
    target.mkdir(exist_ok=True)
    (target / 'discovery.json').write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding='utf-8')
    print(json.dumps(data, ensure_ascii=False, indent=2))
