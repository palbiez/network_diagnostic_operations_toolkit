"""Behavioral tests; fake API only, no Linear/network calls."""
import copy
import json
from pathlib import Path
import sys
import tempfile
import unittest

sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
import linear_sync as sync

class FakeLinear:
    def __init__(self,issue,raced=False,removed=False):
        self.issue=copy.deepcopy(issue);self.mutations=[];self.raced=raced;self.removed=removed
    def query(self,query,variables=None):
        if 'states(first:' in query:return {'team':{'states':{'nodes':[{'id':'todo','name':'Todo','type':'unstarted','position':1},{'id':'done','name':'Done','type':'completed','position':2}]}}}
        if 'issues(first:' in query:
            return {'project':{'id':'project','issues':{'nodes':[] if self.removed else [copy.deepcopy(self.issue)],'pageInfo':{'hasNextPage':False}}}}
        if 'issueUpdate' in query:
            self.mutations.append(variables['input'])
            for field,value in variables['input'].items():
                if field=='stateId':self.issue['state']={'id':value,'name':value.title(),'type':'completed' if value=='done' else 'unstarted'}
                else:self.issue[field]=value
            self.issue['updatedAt']='updated'
            return {'issueUpdate':{'success':True,'issue':copy.deepcopy(self.issue)}}
        if 'issue(id:' in query:
            return {'issue':{'updatedAt':'raced' if self.raced else self.issue['updatedAt'],'project':{'id':'project'}}}
        raise AssertionError(query)

class SyncTests(unittest.TestCase):
    def setUp(self):
        self.temp=tempfile.TemporaryDirectory(prefix='omr-linear-sync-test-')
        self.previous=sync.DIR;sync.DIR=Path(self.temp.name)
        self.config={'projectId':'project','teamId':'team','projectUrl':'https://example.test/project','states':[]}
        self.issue={'id':'id','identifier':'PHI-1','title':'Original','description':'Evidence','priority':3,'state':{'id':'todo','name':'Todo','type':'unstarted'},'url':'https://example.test/issue','updatedAt':'baseline','archivedAt':None,'team':{'id':'team'},'project':{'id':'project'}}
        sync.write_local(self.issue)
        sync.save(sync.DIR/'sync-state.json',{'issues':{'id':{'base':sync.values(self.issue),'updatedAt':'baseline','identifier':'PHI-1'}}})
    def tearDown(self):
        sync.DIR=self.previous;self.temp.cleanup()
    def edit(self,**fields):
        path=sync.DIR/'issues/PHI-1.json';data=sync.read(path)
        for field,value in fields.items():
            if field=='description':(sync.DIR/'issues/PHI-1.md').write_text(value,encoding='utf-8')
            else:data[field]=value
        sync.save(path,data)
    def test_remote_edit_is_pulled_without_mutation(self):
        api=FakeLinear(self.issue);api.issue['description']='Remote evidence';api.issue['updatedAt']='remote'
        self.assertEqual(sync.synchronize(api,self.config),0)
        self.assertEqual(sync.local_values(self.issue)['description'],'Remote evidence');self.assertEqual(api.mutations,[])
    def test_local_edit_is_pushed_and_read_back(self):
        self.edit(stateId='done',description='Verified fix')
        api=FakeLinear(self.issue);self.assertEqual(sync.synchronize(api,self.config),0)
        self.assertEqual(api.mutations,[{'description':'Verified fix','stateId':'done'}])
        self.assertEqual(sync.read(sync.DIR/'sync-state.json')['issues']['id']['base']['stateId'],'done')
    def test_conflicting_same_field_preserves_both_and_baseline(self):
        self.edit(description='Local evidence');api=FakeLinear(self.issue);api.issue['description']='Remote evidence'
        self.assertEqual(sync.synchronize(api,self.config),2)
        self.assertEqual(api.mutations,[]);self.assertEqual(sync.local_values(self.issue)['description'],'Local evidence')
        self.assertEqual(sync.read(sync.DIR/'sync-state.json')['issues']['id']['base']['description'],'Evidence')
        self.assertEqual(sync.read(sync.DIR/'conflicts.json')['conflicts'][0]['fields'],['description'])
    def test_different_fields_merge_without_overwrite(self):
        self.edit(description='Local evidence');api=FakeLinear(self.issue);api.issue['priority']=2;api.issue['updatedAt']='remote'
        self.assertEqual(sync.synchronize(api,self.config),0)
        self.assertEqual(api.mutations,[{'description':'Local evidence'}]);self.assertEqual(sync.local_values(self.issue)['priority'],2)
    def test_remote_race_blocks_mutation(self):
        self.edit(title='Local title');api=FakeLinear(self.issue,raced=True)
        self.assertEqual(sync.synchronize(api,self.config),2);self.assertEqual(api.mutations,[])
    def test_project_removal_does_not_recreate_or_delete(self):
        api=FakeLinear(self.issue,removed=True);self.assertEqual(sync.synchronize(api,self.config),0)
        self.assertTrue((sync.DIR/'issues/PHI-1.md').exists());self.assertEqual(api.mutations,[])
        self.assertEqual(sync.read(sync.DIR/'conflicts.json')['missingFromProject'],['PHI-1'])
    def test_pull_does_not_push_local_changes(self):
        self.edit(title='Pending title');api=FakeLinear(self.issue)
        self.assertEqual(sync.synchronize(api,self.config,pull_only=True),0);self.assertEqual(api.mutations,[])
        self.assertEqual(sync.local_values(self.issue)['title'],'Pending title')

if __name__=='__main__':unittest.main()
