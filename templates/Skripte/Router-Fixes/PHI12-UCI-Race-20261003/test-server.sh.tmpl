#!/bin/bash
umask 077
fail() { echo "FAIL: $*"; exit 1; }
assert_eq() { [ "$1" = "$2" ] || fail "$3: expected $2, got $1"; }
# Unique package names also isolate the default /tmp/.uci search path.
uci() {
 local quiet='' command target
 [ "${1:-}" != "-q" ] || { quiet=-q; shift; }
 command=$1; shift
 if [ "$#" -gt 0 ]; then target="probe_$1"; shift; else target=''; fi
 if [ "$command" = batch ]; then
  sed -E 's/^([[:space:]]*[a-z_]+[[:space:]]+)/\1probe_/' | /sbin/uci -c "$D" -t "$D/state" -p "$D/state" $quiet batch
 elif [ "$command" = show ]; then
  /sbin/uci -c "$D" -t "$D/state" -p "$D/state" $quiet "$command" ${target:+"$target"} "$@" | sed 's/^probe_//'
 else
  /sbin/uci -c "$D" -t "$D/state" -p "$D/state" $quiet "$command" ${target:+"$target"} "$@"
 fi
}
