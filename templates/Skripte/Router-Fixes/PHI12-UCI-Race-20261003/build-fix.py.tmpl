"""Build narrowly scoped patches against the captured, installed OMR files."""
from pathlib import Path
import difflib, hashlib, json

ROOT = Path(__file__).resolve().parents[3]
OUT = Path(__file__).resolve().parent
SRC = ROOT / 'Analyse/PHI-12/messung-20261003'

server = (SRC/'omr-tracker-server-current.sh').read_text(encoding='utf-8')
helper = '''# Only this tracker's actual writes may request a service restart.
# UCI deltas are shared with the scheduler and LuCI; their presence is not
# evidence that this process changed a server or a proxy instance.
_tracker_set_option() {
	local option="$1" value="$2" current
	current=$(uci -q get "$option")
	[ "$current" != "$value" ] || return 0
	uci -q set "$option=$value" || return 1
	changes="1"
}

'''
assert server.count('_disable_redir() {') == 1
server = server.replace('_disable_redir() {', helper + '_disable_redir() {')
replacements = {
    'uci -q set "${shadowsocks}"."${redir}".disabled=1': '_tracker_set_option "${shadowsocks}.${redir}.disabled" 1',
    'uci -q set "${shadowsocks}"."${redir}".disabled=0': '_tracker_set_option "${shadowsocks}.${redir}.disabled" 0',
    'uci -q set shadowsocks-rust.sss${count}.disabled=0': '_tracker_set_option "shadowsocks-rust.sss${count}.disabled" 0',
    'uci -q set shadowsocks-libev.sss${count}.disabled=0': '_tracker_set_option "shadowsocks-libev.sss${count}.disabled" 0',
    'uci -q set openvpn.omr.enabled=1': '_tracker_set_option openvpn.omr.enabled 1',
}
for before, after in replacements.items():
    assert before in server, before
    server = server.replace(before, after)
for package in ['shadowsocks-libev', 'shadowsocks-rust', 'openvpn']:
    import re
    pattern = r'\[ -n "\$\(uci -q changes '+re.escape(package)+r'\)" \]\s*&& \{ changes="1"; uci -q commit '+re.escape(package)+r'; \}'
    server, n = re.subn(pattern, '[ "$changes" = "1" ] && [ -n "$(uci -q changes '+package+')" ] && uci -q commit '+package, server)
    assert n == 2, (package, n)
server = server.replace('# Commit only what actually changed: a no-op `uci commit` still forks\n\t\t# and rewrites nothing but costs file locking and IO every cycle',
    '# Commit proxy packages only after this tracker changed a value.\n\t\t# Do not commit or restart for another process\'s pending edits.')
server = server.replace('# Commit only what actually changed (see _check_master)', '# Same ownership guard as _check_master: ignore foreign pending edits.')

services = (SRC/'010-services-current.sh').read_text(encoding='utf-8')
begin = services.index('set_lan_ips() {')
end = services.index('\nconfig_load network', begin)
replacement = '''# Keep list membership without staging remove/add pairs every minute.
# Retain the existing zone-forwarding policy and per-interface classification.
_uci_sync_list_member() {
	local option="$1" item="$2" wanted="$3" current present=0
	[ -n "$item" ] || return 0
	current=$(uci -q get "$option")
	case " $current " in *" $item "*) present=1;; esac
	if [ "$wanted" = "1" ]; then
		[ "$present" = "1" ] || uci -q add_list "$option=$item"
	else
		[ "$present" = "0" ] || uci -q del_list "$option=$item"
	fi
	return 0
}
set_lan_ips() {
	local ss_wanted=0 lan_wanted=0 wan_wanted=0
	config_get ip4table "$1" ip4table
	config_get device "$1" device
	config_get proto "$1" proto
	config_get multipath "$1" multipath
	# Preserve the existing strong-name handling, without no-op commits.
	case "$device" in
		*-*)
			if [ "$(uci -q get openmptcprouter.settings.restrict_to_lan)" != "0" ]; then
				uci -q set openmptcprouter.settings.restrict_to_lan="0"
				uci -q commit openmptcprouter
			fi
		;;
	esac
	if [ "$multipath" = "on" ] || [ "$multipath" = "master" ]; then
		wan_wanted=1
	elif [ -n "$device" ] && [ -z "$(echo "$device" | grep @)" ] && ([ "$proto" = "dhcp" ] || [ "$proto" = "static" ]); then
		lan_wanted=1
		_intf_zone_forwards_to_wan "$1" && ss_wanted=1
	fi
	_uci_sync_list_member shadowsocks-libev.ss_rules.ifnames "$device" "$ss_wanted"
	_uci_sync_list_member shadowsocks-rust.ss_rules.ifnames "$device" "$ss_wanted"
	_uci_sync_list_member unbound.ub_main.iface_lan "$1" "$lan_wanted"
	_uci_sync_list_member unbound.ub_main.iface_wan "$1" "$wan_wanted"
	_uci_sync_list_member 'dhcp.@dnsmasq[0].interface' "$1" "$lan_wanted"
	_uci_sync_list_member 'dhcp.@dnsmasq[0].notinterface' "$1" "$wan_wanted"
}'''
services = services[:begin] + replacement + services[end:]

manifest = {}
for name, content, source, remote in [
    ('omr-tracker-server', server, 'omr-tracker-server-current.sh', '/bin/omr-tracker-server'),
    ('010-services', services, '010-services-current.sh', '/usr/share/omr/schedule.d/010-services'),
]:
    original = (SRC/source).read_bytes()
    data = content.encode('utf-8')
    (OUT/name).write_bytes(data)
    diff = ''.join(difflib.unified_diff(original.decode().splitlines(True), content.splitlines(True), fromfile=remote+'.before', tofile=remote))
    (OUT/(name+'.patch')).write_text(diff, encoding='utf-8', newline='\n')
    manifest[name] = {'path': remote, 'before_sha256': hashlib.sha256(original).hexdigest(), 'after_sha256': hashlib.sha256(data).hexdigest()}
(OUT/'manifest.json').write_text(json.dumps(manifest, indent=2)+'\n', encoding='utf-8')
print('Built server ownership guard and scheduler list-membership patch.')
