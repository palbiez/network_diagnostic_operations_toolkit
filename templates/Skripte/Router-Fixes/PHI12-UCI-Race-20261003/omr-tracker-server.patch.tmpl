--- /bin/omr-tracker-server.before
+++ /bin/omr-tracker-server
@@ -138,13 +138,24 @@
 	uci -q set openmptcprouter."${serv}".current=0
 }
 
+# Only this tracker's actual writes may request a service restart.
+# UCI deltas are shared with the scheduler and LuCI; their presence is not
+# evidence that this process changed a server or a proxy instance.
+_tracker_set_option() {
+	local option="$1" value="$2" current
+	current=$(uci -q get "$option")
+	[ "$current" != "$value" ] || return 0
+	uci -q set "$option=$value" || return 1
+	changes="1"
+}
+
 _disable_redir() {
 	local redir="$1"
 	local serverdisable="$2"
 	local shadowsocks="$3"
 	config_get serverss "$redir" server
 	if [ "$serverss" = "$serverdisable" ]; then
-		uci -q set "${shadowsocks}"."${redir}".disabled=1
+		_tracker_set_option "${shadowsocks}.${redir}.disabled" 1
 	fi
 }
 
@@ -153,7 +164,7 @@
 	local shadowsocks="$2"
 	config_get serverss "$redir" server
 	if [ "$serverss" = "sss${count}" ]; then
-		uci -q set "${shadowsocks}"."${redir}".disabled=0
+		_tracker_set_option "${shadowsocks}.${redir}.disabled" 0
 	fi
 }
 
