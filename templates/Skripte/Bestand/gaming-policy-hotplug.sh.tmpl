#!/bin/sh
# Keep source-marked Gaming policy tables usable when either WAN changes state.
# Table 3: PlayStation primary WAN1, WAN2 fallback.
# Table 2: Other Gaming clients primary WAN2, WAN1 fallback.

case "$INTERFACE:$ACTION" in
    wan1:ifup|wan1:ifupdate|wan1:ifdown|wan2:ifup|wan2:ifupdate|wan2:ifdown)
        ;;
    *)
        exit 0
        ;;
esac

sleep 2

for table in 2 3; do
    while ip route del default table "$table" 2>/dev/null; do :; done
    while ip route del unreachable default table "$table" 2>/dev/null; do :; done
done

# Both policy tables need both upstream gateway paths for fallback.
ip route replace @@IPV4_092@@/24 dev @@INTERFACE_002@@ scope link table 2 2>/dev/null || true
ip route replace @@IPV4_009@@ dev @@INTERFACE_002@@ scope link table 2 2>/dev/null || true
ip route replace @@IPV4_093@@/24 dev @@INTERFACE_003@@ scope link table 2 2>/dev/null || true
ip route replace @@IPV4_010@@ dev @@INTERFACE_003@@ scope link table 2 2>/dev/null || true
ip route replace @@IPV4_092@@/24 dev @@INTERFACE_002@@ scope link table 3 2>/dev/null || true
ip route replace @@IPV4_009@@ dev @@INTERFACE_002@@ scope link table 3 2>/dev/null || true
ip route replace @@IPV4_093@@/24 dev @@INTERFACE_003@@ scope link table 3 2>/dev/null || true
ip route replace @@IPV4_010@@ dev @@INTERFACE_003@@ scope link table 3 2>/dev/null || true

# WAN1 primary for the PlayStation, WAN2 backup.
ip route add default via @@IPV4_009@@ dev @@INTERFACE_002@@ metric 10 table 3 2>/dev/null || true
ip route add default via @@IPV4_010@@ dev @@INTERFACE_003@@ metric 20 table 3 2>/dev/null || true

# WAN2 primary for all other Gaming clients, WAN1 backup.
ip route add default via @@IPV4_010@@ dev @@INTERFACE_003@@ metric 10 table 2 2>/dev/null || true
ip route add default via @@IPV4_009@@ dev @@INTERFACE_002@@ metric 20 table 2 2>/dev/null || true
